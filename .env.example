# KhoborDaily environment configuration.
# Copy to .env.local and fill before launch. Never commit secrets.

# Public site URL (no trailing slash). Used for canonical URLs & sitemaps.
NEXT_PUBLIC_SITE_URL=https://khobordaily.vercel.app

# Who operates the site. Fill in real values before launch — never invent.
NEXT_PUBLIC_PUBLISHER_NAME=Example News Ltd.
NEXT_PUBLIC_PUBLISHER_NAME_BN=উদাহরণ নিউজ লিঃ

# Search Console / Webmaster Tools verification tokens (optional).
# When set, these are rendered as <meta name="google-site-verification">
# and <meta name="msvalidate.1"> tags on every page.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Supabase project credentials (used by the optional /api/ routes and
# by scripts/check-feeds.ts). Leave blank for the static build.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Bearer token for /api/cron/ingest. Generate a long random value, e.g.
#   openssl rand -hex 32
# Set the same value in Vercel (Project → Settings → Environment Variables)
# and in GitHub (Settings → Secrets and variables → Actions → CRON_SECRET).
# Vercel Cron sends it automatically; the GitHub Action sends it explicitly.
CRON_SECRET=
